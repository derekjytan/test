OPENAI_API_KEY=ADD_YOUR_OPENAI_API_KEY_HERE
# Optional; e.g. https://us.api.openai.com/v1 for US data-residency projects.
OPENAI_BASE_URL=https://api.openai.com/v1
# Optional worker polling interval. The starter worker performs no work.
WORKER_POLL_SECONDS=5
